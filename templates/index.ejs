
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="description" content="Get a concise summary of recent and helpful reviews for any Steam game.">
    <title>Steam Review Summarizer</title>
    <link rel="stylesheet" href="/css/style.css">
    <script src="/js/search.js" defer></script>
</head>
<body>
<%- include("partials/header", { showHomeLink: false }) %>
<main class="shell home">
    <section class="intro" aria-labelledby="page-title">
        <h1 id="page-title">What are players<br class="intro-break"> <span>saying?</span></h1>
        <p>Get a concise summary of helpful and recent Steam reviews, with the numbers alongside it.</p>
    </section>

    <form class="panel search-panel" action="/display" method="post">
        <label for="in">Steam store link</label>
        <div class="search-row">
            <input type="url" id="in" name="in" required maxlength="512" inputmode="url"
                   autocapitalize="none" spellcheck="false" placeholder="https://store.steampowered.com/app/..."
                   value="<%= input %>" aria-describedby="search-hint<%= error ? ' search-error' : '' %>"
                   <% if (error) { %>aria-invalid="true"<% } %>>
            <button class="button button-primary" type="submit"><span data-button-label>Summarize reviews</span><span aria-hidden="true">→</span></button>
        </div>
        <% if (error) { %><p class="form-error" id="search-error" role="alert"><%= error %></p><% } %>
        <div class="search-meta">
            <p id="search-hint">Paste the URL from a game’s Steam store page.</p>
            <button class="text-button" type="button" data-example hidden>Try Portal 2 <span aria-hidden="true">↗</span></button>
        </div>
        <p class="loading" role="status" hidden>Fetching reviews and preparing your summary. This can take about a minute.</p>
    </form>
</main>
</body>
</html>
