
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><%= heading %> · Steam Review Summarizer</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
<%- include("partials/header", { showHomeLink: false }) %>
<main class="shell error-page">
    <section class="panel error-panel" aria-labelledby="error-title">
        <h1 id="error-title"><%= heading %></h1>
        <p><%= message %></p>
        <a class="button button-primary" href="/">← Back to search</a>
    </section>
</main>
</body>
</html>
